     reader: &mut bam::Reader,
-    decisions: &mut File,
+    decisions: &mut impl IoRead,
     ordinal: &mut u64,
     next_duplicate: &mut Option<(u64, ExternalDecision)>,
     config: &MarkDuplicatesConfig,
@@ -1726,16 +1726,37 @@ fn try_run_single_bam_compact_plan(
         config,
     )?;
     drop(reader);
+    drop(read_ends);
+    drop(eligible_indices);
 
