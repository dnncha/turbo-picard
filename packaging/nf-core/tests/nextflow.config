params {
    test_bam = "${System.getenv('TURBO_PICARD_REPO_ROOT') ?: System.getenv('PWD') ?: System.getProperty('user.dir')}/fixtures/markduplicates/basic/input.bam"
    test_cram = "${System.getenv('TURBO_PICARD_REPO_ROOT') ?: System.getenv('PWD') ?: System.getProperty('user.dir')}/benchmarks/real-data/gatk-na12878-mito-cram/input.cram"
    test_fasta = "${System.getenv('TURBO_PICARD_REPO_ROOT') ?: System.getenv('PWD') ?: System.getProperty('user.dir')}/fixtures/reference/chrM.fa"
    test_fai = "${System.getenv('TURBO_PICARD_REPO_ROOT') ?: System.getenv('PWD') ?: System.getProperty('user.dir')}/fixtures/reference/chrM.fa.fai"
}

process {
    withName: TURBO_PICARD_MARKDUPLICATES {
        ext.prefix = { "${meta.id}.md" }
        ext.args = 'ASSUME_SORTED=true VALIDATION_STRINGENCY=SILENT QUIET=true'
    }
}
